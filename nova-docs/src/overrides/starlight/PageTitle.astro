---
import DefaultPageTitle from '@astrojs/starlight/components/PageTitle.astro';
import CopyMarkdownButton from '../../components/CopyMarkdownButton.astro';
import { getDocCopyMarkdown } from '../../utils/copy-markdown';

const { entry } = Astro.locals.starlightRoute;

const copyText = await getDocCopyMarkdown(entry.id);
const copySrc = `${import.meta.env.BASE_URL}raw/${entry.id}.md`;
---

{
  entry.data.hideTitle ? null : (
    <div class="flex flex-wrap items-center gap-x-4 gap-y-2 [&>h1]:min-w-0 [&>h1]:grow">
      <DefaultPageTitle />
      {copyText && <CopyMarkdownButton src={copySrc} />}
    </div>
  )
}
{
  entry.data.hideTitle && (
    <style is:global>
      .content-panel:first-child {
        padding: 0 !important;
        display: none;
      }
    </style>
  )
}
