---
import { Tabs, TabItem } from '@astrojs/starlight/components';
import { getPathByLocale } from 'astro:i18n';
import CodeFile from 'starlight-theme-nova/components/CodeFile.astro';
import { attrsOf, definitionName, resolveSchemaPreviewFiles } from '../utils/preview-sources';

interface Props {
  /**
   * 定义文件路径（相对项目根），代码 tab 仅展示该文件中的「定义」。
   * 例如 `src/angular/definition/type-string.definition.ts`
   */
  definition: string;
  /**
   * 预览 tab 的标签，默认「预览」
   */
  previewLabel?: string;
  /**
   * 定义 tab 的标签，默认「定义」
   */
  codeLabel?: string;
}

const { definition, previewLabel = '预览', codeLabel = '定义' } = Astro.props;

const files = resolveSchemaPreviewFiles(attrsOf({ definition }));

if (files.length === 0) {
  throw new Error('SchemaPreview 需要提供 definition 属性');
}

const locale = Astro.currentLocale ?? 'zh-CN';
// currentLocale 是 BCP-47 码（zh-CN），URL 用的是配置里的 path（zh），需要映射一次
const localePath = getPathByLocale(locale);
const playgroundHref = `${import.meta.env.BASE_URL}${localePath}/playground/?def=${definitionName(files[0])}`;
---

<div class="schema-preview">
  <a
    class="schema-preview-playground btn btn-xs btn-ghost btn-circle tooltip tooltip-bottom"
    href={playgroundHref}
    target="_blank"
    rel="noopener"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="14"
      height="14"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <polygon points="6 3 20 12 6 21 6 3"></polygon>
    </svg>
  </a>
  <Tabs>
    <TabItem label={previewLabel}>
      <slot name="preview" />
    </TabItem>
    <TabItem label={codeLabel}>
      <CodeFile path={files[0]} />
    </TabItem>
  </Tabs>
</div>

<style>
  .schema-preview {
    position: relative;
    margin: 1.5rem 0;
  }

  /* 叠在 tab 栏右侧，避免额外占一行 */
  .schema-preview-playground {
    position: absolute;
    top: 0.2rem;
    right: 0.2rem;
    z-index: 2;
  }

  .schema-preview :global(.tablist-wrapper) {
    padding-inline-end: 3rem;
  }

  .schema-preview :global(starlight-tabs [data-nova-code-container]) {
    border-radius: 0;
  }
</style>
