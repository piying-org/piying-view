{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "noEmit": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.typetest.tsbuildinfo",
    "paths": {
      "@piying/view-core": ["../../dist/view-core"],
      "@piying/view-core/test": ["../../dist/view-core/test"],
      "@piying/view-vue": ["./src/index.ts"]
    }
  },
  "files": ["./src/vite-env.d.ts"],
  "include": [
    "src/__typetests__/**/*.test-d.ts",
    "src/__tests__/util/field-fixture.ts",
    "src/__tests__/util/type-assert.ts",
    "src/__tests__/component/field-bind-test.vue"
  ],
  "exclude": []
}
